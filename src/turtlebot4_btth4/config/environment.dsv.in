set;ROS_DOMAIN_ID;44
# Humble otherwise adds an SHM transport even when XML disables built-in transports.
# The XML interface whitelist itself restricts this workspace to 127.0.0.1.
set;ROS_LOCALHOST_ONLY;0
set;RMW_IMPLEMENTATION;rmw_fastrtps_cpp
set;FASTRTPS_DEFAULT_PROFILES_FILE;@CMAKE_INSTALL_PREFIX@/share/turtlebot4_btth4/config/fastdds.xml
set;RMW_FASTRTPS_PUBLICATION_MODE;ASYNCHRONOUS
set;RMW_FASTRTPS_USE_QOS_FROM_XML;0
set;IGN_PARTITION;turtlebot4_btth4
set;IGN_IP;127.0.0.1
set;GZ_IP;127.0.0.1
set;ROS_LOG_DIR;@BTTH4_WORKSPACE@/log/ros
prepend-non-duplicate;AMENT_PREFIX_PATH;@BTTH4_WORKSPACE@/.deps/install/tf2_ros
prepend-non-duplicate;AMENT_PREFIX_PATH;@BTTH4_WORKSPACE@/.deps/control_runtime
prepend-non-duplicate;AMENT_PREFIX_PATH;@BTTH4_WORKSPACE@/.deps/slam_runtime
prepend-non-duplicate;LD_LIBRARY_PATH;@BTTH4_WORKSPACE@/.deps/install/tf2_ros/lib
prepend-non-duplicate;LD_LIBRARY_PATH;@BTTH4_WORKSPACE@/.deps/slam_runtime/lib
@BTTH4_GPU_ENVIRONMENT@
